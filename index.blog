let expenses = [];
let sales = [];
let lastProfit = 0;
let lastPercent = 0;
let lastRevenue = 0;

document.getElementById('expDate').valueAsDate = new Date();

function calculate() {
  let product = document.getElementById('product').value || "Product";
  let cost = Number(document.getElementById('cost').value) || 0;
  let sell = Number(document.getElementById('sell').value) || 0;
  let qty = Number(document.getElementById('qty').value) || 1;
  if(cost <= 0){ alert("Cost must be greater than 0"); return; }

  let revenue = sell * qty;
  let profit = (sell - cost) * qty;
  let percent = cost > 0? ((sell - cost) / cost) * 100 : 0;

  sales.push({product, cost, sell, qty, revenue, profit, date: new Date().toISOString().split('T')[0]});

  lastProfit = profit; lastPercent = percent; lastRevenue = revenue;

  document.getElementById('revenue').innerText = revenue.toLocaleString();
  document.getElementById('profit').innerText = profit.toLocaleString();
  document.getElementById('percent').innerText = percent.toFixed(1);
  document.getElementById('product').value = "";
  updateDashboard();
}

function saveExpense() {
  let amount = Number(document.getElementById('amount').value) || 0;
  let category = document.getElementById('category').value;
  let date = document.getElementById('expDate').value;
  let description = document.getElementById('description').value;
  if(amount <= 0) { alert("Amount must be greater than 0"); return; }
  if(date == "") { alert("Please pick a date"); return; }

  expenses.push({id: Date.now(), amt: amount, cat: category, date: date, desc: description});
  document.getElementById('amount').value = ""; document.getElementById('description').value = "";
  showReport('all'); updateDashboard();
}

function deleteExpense(id) {
  if(confirm("Delete this expense?")){
    expenses = expenses.filter(e => e.id!== id);
    showReport('all'); updateDashboard();
  }
}

function showReport(filter) {
  let today = new Date(); let filtered = [];
  if(filter == 'daily'){ let todayStr = today.toISOString().split('T')[0]; filtered = expenses.filter(e => e.date == todayStr); document.getElementById('reportSummary').innerHTML = `<b>Daily Expenses - Today</b>`; }
  else if(filter == 'weekly'){ let weekAgo = new Date(today); weekAgo.setDate(today.getDate() - 7); filtered = expenses.filter(e => new Date(e.date) >= weekAgo); document.getElementById('reportSummary').innerHTML = `<b>Weekly Expenses - Last 7 Days</b>`; }
  else if(filter == 'monthly'){ let month = today.getMonth(); let year = today.getFullYear(); filtered = expenses.filter(e => { let d = new Date(e.date); return d.getMonth() == month && d.getFullYear() == year; }); document.getElementById('reportSummary').innerHTML = `<b>Monthly Expenses - This Month</b>`; }
  else { filtered = expenses; document.getElementById('reportSummary').innerHTML = `<b>All Time Expenses</b>`; }

  let total = 0; let listHTML = "<br>";
  for(let i = 0; i < filtered.length; i++) {
    total += filtered[i].amt;
    listHTML += `${filtered[i].date} | ${filtered[i].cat} | ₦${filtered[i].amt.toLocaleString()} | ${filtered[i].desc}
    <button onclick="deleteExpense(${filtered[i].id})">[X]</button><br>`;
  }
  listHTML += `<br><b>Total: ₦${total.toLocaleString()}</b>`;
  document.getElementById('expenseList').innerHTML = listHTML;
}

function updateDashboard() {
  let today = new Date(); let month = today.getMonth(); let year = today.getFullYear();
  let monthlySales = sales.filter(s => { let d = new Date(s.date); return d.getMonth() == month && d.getFullYear() == year; });
  let monthlyExp = expenses.filter(e => { let d = new Date(e.date); return d.getMonth() == month && d.getFullYear() == year; });
  let totalRevenue = monthlySales.reduce((a,b) => a + b.revenue, 0);
  let totalProfit = monthlySales.reduce((a,b) => a + b.profit, 0);
  let totalExpMonth = monthlyExp.reduce((a,b) => a + b.amt, 0);
  let catTotals = {}; monthlyExp.forEach(e => { catTotals[e.cat] = (catTotals[e.cat] || 0) + e.amt; });
  let bestCat = Object.keys(catTotals).length > 0? Object.keys(catTotals).reduce((a, b) => catTotals[a] > catTotals[b]? a : b) : "None";

  document.getElementById('totalRevenue').innerText = totalRevenue.toLocaleString();
  document.getElementById('totalProfit').innerText = totalProfit.toLocaleString();
  document.getElementById('totalExpMonth').innerText = totalExpMonth.toLocaleString();
  document.getElementById('netBalance').innerText = (totalProfit - totalExpMonth).toLocaleString();
  document.getElementById('bestCat').innerText = bestCat;
  document.getElementById('totalTrans').innerText = sales.length + expenses.length;
}

function saveResult() {
  let data = {bizName: document.getElementById('bizName').value, sales, expenses, date: new Date().toLocaleString()};
  localStorage.setItem('techHubDataV51', JSON.stringify(data));
  alert("Result Saved!");
}

function downloadCSV() {
  let csv = "Date,Type,Product/Category,Description,Amount,Qty\n";
  sales.forEach(s => { csv += `${s.date},Sale,${s.product},,${s.revenue},${s.qty}\n`; });
  expenses.forEach(e => { csv += `${e.date},Expense,${e.cat},${e.desc},${e.amt},\n`; });
  let blob = new Blob([csv], {type: 'text/csv'});
  let url = URL.createObjectURL(blob);
  let a = document.createElement('a'); a.href = url; a.download = `TEH_Business_Report_${Date.now()}.csv`; a.click();
  alert("CSV Downloaded!");
}

function downloadPDF() {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF();
  let biz = document.getElementById('bizName').value || "Your Business";
  let totalRevenue = sales.reduce((a,b) => a + b.revenue, 0);
  let totalProfit = sales.reduce((a,b) => a + b.profit, 0);
  let totalExp = expenses.reduce((a,b) => a + b.amt, 0);

  doc.setFontSize(16);
  doc.text(`TECH ENTREPRENEUR HUB`, 20, 20);
  doc.setFontSize(12);
  doc.text(`${biz} - Business Report`, 20, 30);
  doc.setFontSize(11);
  doc.text(`Date: ${new Date().toLocaleString()}`, 20, 40);
  doc.text(`Total Revenue: ₦${totalRevenue.toLocaleString()}`, 20, 50);
  doc.text(`Total Profit: ₦${totalProfit.toLocaleString()}`, 20, 60);
  doc.text(`Total Expenses: ₦${totalExp.toLocaleString()}`, 20, 70);
  doc.text(`Net Balance: ₦${(totalProfit - totalExp).toLocaleString()}`, 20, 80);

  let y = 95;
  doc.text("Expenses:", 20, y);
  expenses.forEach(item => {
    y += 8; if(y > 280){ doc.addPage(); y = 20; }
    doc.text(`${item.date} - ${item.cat} - ₦${item.amt.toLocaleString()} - ${item.desc}`, 20, y);
  });
  doc.save(`TEH_Report_${Date.now()}.pdf`);
  alert("PDF Downloaded!");
}

function clearAll() {
  if(confirm("Clear everything?")) {
    expenses = []; sales = []; lastProfit = 0;
    document.getElementById('bizName').value = "";
    document.getElementById('expenseList').innerHTML = "";
    updateDashboard();
    localStorage.removeItem('techHubDataV51');
  }
}

// LOAD SAVED DATA
window.onload = function() {
  let saved = localStorage.getItem('techHubDataV51');
  if(saved) {
    let data = JSON.parse(saved);
    document.getElementById('bizName').value = data.bizName;
    sales = data.sales || [];
    expenses = data.expenses || [];
    showReport('all'); updateDashboard();
  }
}














    !.. Functions of search record & functions of daily, weekly, monthly, yearly...! 
    
    
    
    function setupPeriodButtons() {
    const buttons = {
        daily: document.getElementById("dailyBtn"),
        weekly: document.getElementById("weeklyBtn"),
        monthly: document.getElementById("monthlyBtn"),
        yearly: document.getElementById("yearlyBtn")
    };

    Object.keys(buttons).forEach(function (period) {
        const button = buttons[period];

        if (!button) {
            return;
        }

        button.type = "button";

        button.onclick = function (event) {
            event.preventDefault();
            event.stopPropagation();
            setPeriod(period);
        };
    });
}

function setPeriod(period) {
    const validPeriods = [
        "daily",
        "weekly",
        "monthly",
        "yearly"
    ];

    if (!validPeriods.includes(period)) {
        return;
    }

    currentPeriod = period;

    const buttons = {
        daily: document.getElementById("dailyBtn"),
        weekly: document.getElementById("weeklyBtn"),
        monthly: document.getElementById("monthlyBtn"),
        yearly: document.getElementById("yearlyBtn")
    };

    Object.keys(buttons).forEach(function (key) {
        if (buttons[key]) {
            buttons[key].classList.remove("active");
        }
    });

    if (buttons[period]) {
        buttons[period].classList.add("active");
    }

    const titles = {
        daily: "Daily Records",
        weekly: "Weekly Records",
        monthly: "Monthly Records",
        yearly: "Yearly Records"
    };

    const title = document.getElementById("recordTitle");

    if (title) {
        title.textContent = titles[period];
    }

    displayRecords();
    updateDashboard();
}

function filterByPeriod(record) {
    const recordDate = parseLocalDate(record.date);
    const today = new Date();

    today.setHours(0, 0, 0, 0);
    recordDate.setHours(0, 0, 0, 0);

    if (currentPeriod === "daily") {
        return (
            recordDate.getFullYear() === today.getFullYear() &&
            recordDate.getMonth() === today.getMonth() &&
            recordDate.getDate() === today.getDate()
        );
    }

    if (currentPeriod === "weekly") {
        const startOfWeek = getStartOfWeek(today);
        const endOfWeek = new Date(startOfWeek);

        endOfWeek.setDate(endOfWeek.getDate() + 7);

        return (
            recordDate >= startOfWeek &&
            recordDate < endOfWeek
        );
    }

    if (currentPeriod === "monthly") {
        return (
            recordDate.getFullYear() === today.getFullYear() &&
            recordDate.getMonth() === today.getMonth()
        );
    }

    if (currentPeriod === "yearly") {
        return (
            recordDate.getFullYear() === today.getFullYear()
        );
    }

    return false;
}

function getStartOfWeek(date) {
    const result = new Date(date);

    result.setHours(0, 0, 0, 0);

    const day = result.getDay();
    const difference = day === 0 ? 6 : day - 1;

    result.setDate(result.getDate() - difference);

    return result;
}

function displayRecords() {
    const table = document.getElementById("recordTable");
    const searchInput = document.getElementById("search");

    if (!table) {
        return;
    }

    const searchText = searchInput
        ? searchInput.value.toLowerCase().trim()
        : "";

    let filteredRecords = records.filter(filterByPeriod);

    if (searchText) {
        filteredRecords = filteredRecords.filter(function (record) {
            return (
                record.description
                    .toLowerCase()
                    .includes(searchText) ||
                getTypeName(record.type)
                    .toLowerCase()
                    .includes(searchText)
            );
        });
    }

    table.innerHTML = "";

    if (filteredRecords.length === 0) {
        table.innerHTML = `
            <tr>
                <td colspan="5" class="empty">
                    No records found.
                </td>
            </tr>
        `;

        return;
    }

    filteredRecords.sort(function (a, b) {
        return b.id - a.id;
    });

    filteredRecords.forEach(function (record) {
        const row = document.createElement("tr");

        row.innerHTML = `
            <td>${formatDate(record.date)}</td>
            <td>${escapeHTML(record.description)}</td>
            <td class="${getTypeClass(record.type)}">
                ${getTypeName(record.type)}
            </td>
            <td>₦${formatMoney(record.amount)}</td>
            <td>
                <button
                    type="button"
                    class="delete-btn"
                    onclick="deleteRecord(${record.id})"
                >
                    Delete
                </button>
            </td>
        `;

        table.appendChild(row);
    });
}

const searchInput = document.getElementById("search");

if (searchInput) {
    searchInput.addEventListener("input", function () {
        displayRecords();
    });
}

function deleteRecord(id) {
    const record = records.find(function (item) {
        return item.id === id;
    });

    if (!record) {
        return;
    }

    if (!confirm(`Delete "${record.description}"?`)) {
        return;
    }

    records = records.filter(function (item) {
        return item.id !== id;
    });

    saveRecords();
    displayRecords();
    updateDashboard();
}

function updateDashboard() {
    const periodRecords = records.filter(filterByPeriod);

    let totalSales = 0;
    let totalExpenses = 0;
    let totalCredit = 0;
    let totalCreditPayments = 0;

    periodRecords.forEach(function (record) {
        const amount = Number(record.amount);

        if (record.type === "sale") {
            totalSales += amount;
        }

        if (record.type === "expense") {
            totalExpenses += amount;
        }

        if (record.type === "credit") {
            totalSales += amount;
            totalCredit += amount;
        }

        if (record.type === "credit_payment") {
            totalCreditPayments += amount;
        }
    });

    const profit = totalSales - totalExpenses;

    const outstandingCredit = Math.max(
        totalCredit - totalCreditPayments,
        0
    );

    const salesElement = document.getElementById("totalSales");
    const expensesElement = document.getElementById("totalExpenses");
    const profitElement = document.getElementById("totalProfit");
    const creditElement = document.getElementById("totalCredit");

    if (salesElement) {
        salesElement.textContent =
            `₦${formatMoney(totalSales)}`;
    }

    if (expensesElement) {
        expensesElement.textContent =
            `₦${formatMoney(totalExpenses)}`;
    }

    if (profitElement) {
        profitElement.textContent =
            `₦${formatMoney(profit)}`;
    }

    if (creditElement) {
        creditElement.textContent =
            `₦${formatMoney(outstandingCredit)}`;
    }
}

function createDownloadButton() {
    const tableSection =
        document.querySelector(".table-section");

    if (!tableSection) {
        return;
    }

    if (
        document.getElementById(
            "downloadRecordsBtn"
        )
    ) {
        return;
    }

    const button =
        document.createElement("button");

    button.id = "downloadRecordsBtn";
    button.textContent = "Download Records";
    button.type = "button";
    button.style.marginBottom = "15px";
    button.style.background = "#16a34a";
    button.onclick = downloadRecords;

    const title =
        document.getElementById("recordTitle");

    if (title) {
        title.insertAdjacentElement(
            "afterend",
            button
        );
    } else {
        tableSection.prepend(button);
    }
}

function downloadRecords() {
    let downloadList =
        records.filter(filterByPeriod);

    const searchInput =
        document.getElementById("search");

    const searchText = searchInput
        ? searchInput.value.toLowerCase().trim()
        : "";

    if (searchText) {
        downloadList = downloadList.filter(function (record) {
            return (
                record.description
                    .toLowerCase()
                    .includes(searchText) ||
                getTypeName(record.type)
                    .toLowerCase()
                    .includes(searchText)
            );
        });
    }

    if (downloadList.length === 0) {
        alert("There are no records to download.");
        return;
    }

    downloadList.sort(function (a, b) {
        return (
            parseLocalDate(a.date) -
            parseLocalDate(b.date)
        );
    });

    let csv =
        "Date,Description,Type,Amount\n";

    downloadList.forEach(function (record) {
        const description =
            `"${String(record.description)
                .replace(/"/g, '""')}"`;

        const type =
            `"${getTypeName(record.type)}"`;

        csv +=
            `"${record.date}",${description},${type},"${record.amount}"\n`;
    });

    const blob = new Blob(
        [csv],
        {
            type: "text/csv;charset=utf-8;"
        }
    );

    const url =
        URL.createObjectURL(blob);

    const link =
        document.createElement("a");

    const periodName =
        currentPeriod.charAt(0).toUpperCase() +
        currentPeriod.slice(1);

    link.href = url;

    link.download =
        `Shop-Book-${periodName}-Records.csv`;

    document.body.appendChild(link);

    link.click();

    document.body.removeChild(link);

    URL.revokeObjectURL(url);
}

function getTypeName(type) {
    const names = {
        sale: "Sale",
        expense: "Expense",
        credit: "Credit Given",
        credit_payment: "Credit Payment"
    };

    return names[type] || type;
}

function getTypeClass(type) {
    if (type === "sale") {
        return "type-sale";
    }

    if (type === "expense") {
        return "type-expense";
    }

    if (
        type === "credit" ||
        type === "credit_payment"
    ) {
        return "type-credit";
    }

    return "";
}

function formatMoney(amount) {
    return Number(amount).toLocaleString(
        "en-NG",
        {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        }
    );
}

function formatDate(dateString) {
    return parseLocalDate(
        dateString
    ).toLocaleDateString(
        "en-NG",
        {
            day: "2-digit",
            month: "short",
            year: "numeric"
        }
    );
}

function escapeHTML(text) {
    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;
}
    
    